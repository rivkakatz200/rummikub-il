# ── Gemini AI (bot moves) ──────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
# Without this key the bot uses the built-in heuristic fallback (still playable).
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini model to use.
# Current stable Flash models (as of mid-2025): gemini-2.0-flash, gemini-1.5-flash
# Default is gemini-2.0-flash. Change only if you get a "model not found" error.
# Full list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL="gemini-3.5-flash"

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
